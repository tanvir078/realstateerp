# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=slbl_erp
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
DB_LOGGING=true

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Company
COMPANY_NAME=Sardar Landmark & Builders Ltd.
COMPANY_SHORT_NAME=SLBL
COMPANY_ADDRESS=Pallabi, Dhaka, Bangladesh
COMPANY_PHONE=+880 1405-857553
COMPANY_EMAIL=info@sardarlandmark.com
COMPANY_WEBSITE=https://slblerp.site

# Currency
DEFAULT_CURRENCY=BDT
TIMEZONE=Asia/Dhaka
