          <h3 className="text-lg font-semibold text-white mb-1">Stacking Matrix View</h3>
          <p className="text-sm text-[#829B96]">
            Visual floor-by-floor unit grid will be displayed here.
          </p>
        </div>
      )}

      {/* Export Modal */}
      <ExportModal
        isOpen={isExportModalOpen}
        onClose={() => setIsExportModalOpen(false)}
        onExport={handleExport}
        availableColumns={["Unit Code", "Project", "Floor", "Type", "Size", "Facing", "Bedrooms", "Bathrooms", "Base Price/Sft", "Parking Price", "Utility Charges", "Total Price", "Ownership", "Status"]}
        defaultColumns={["Unit Code", "Project", "Floor", "Type", "Size", "Total Price", "Ownership", "Status"]}
        title="Export Units List"
      />

      {/* Add Unit Modal */}
      <AddUnitModal
        isOpen={isAddUnitModalOpen}
        onClose={() => setIsAddUnitModalOpen(false)}
        onSave={handleAddUnit}
        projects={[
          { id: "1", name: "Sobhagya Green Valley" },
          { id: "2", name: "Sobhagya Grand Heights" },
          { id: "3", name: "City Vista Plaza" }
