import { useState } from "react";
import { Button } from "@/components/ui/Button";
import { 
  Search, Filter, Download, ChevronRight, Plus, 
  Building2, Layers, Home, Eye, Edit, Grid, Table, CheckCircle2
} from "lucide-react";
import ExportModal from "@/components/forms/ExportModal";
import AddUnitModal from "@/components/forms/AddUnitModal";
import BulkCreateUnitsModal from "@/components/forms/BulkCreateUnitsModal";

interface Unit {
  id: string;
  unitCode: string;
  projectName: string;
  floorLevel: string;
  unitType: "APARTMENT" | "COMMERCIAL_SHOP" | "PARKING" | "OFFICE_SPACE";
  size: number;
  facing: string;
  bedrooms: number;
  bathrooms: number;
  basePricePerSft: number;
  parkingPrice: number;
  utilityCharges: number;
  totalPrice: number;
  ownership: "DEVELOPER_SHARE" | "LANDOWNER_SHARE";
  status: "AVAILABLE" | "BOOKED" | "SOLD" | "BLOCKED";
}

export default function UnitsPage() {
  const [searchTerm, setSearchTerm] = useState("");
  const [selectedType, setSelectedType] = useState<string>("ALL");
  const [selectedStatus, setSelectedStatus] = useState<string>("ALL");
  const [viewMode, setViewMode] = useState<"TABLE" | "MATRIX">("TABLE");
  const [isExportModalOpen, setIsExportModalOpen] = useState(false);
  const [isAddUnitModalOpen, setIsAddUnitModalOpen] = useState(false);
  const [isBulkCreateModalOpen, setIsBulkCreateModalOpen] = useState(false);

  // Mock Units Data
  const [units] = useState<Unit[]>([
    {
      id: "1",
      unitCode: "Apt #4-A",
      projectName: "Sobhagya Green Valley",
      floorLevel: "4th Floor",
      unitType: "APARTMENT",
      size: 1450,
      facing: "South",
      bedrooms: 3,
      bathrooms: 3,
      basePricePerSft: 6500,
      parkingPrice: 400000,
      utilityCharges: 200000,
      totalPrice: 9925000,
      ownership: "DEVELOPER_SHARE",
      status: "AVAILABLE"
    },
    {
      id: "2",
      unitCode: "Apt #4-B",
      projectName: "Sobhagya Green Valley",
      floorLevel: "4th Floor",
      unitType: "APARTMENT",
      size: 1650,
      facing: "North",
      bedrooms: 3,
      bathrooms: 3,
      basePricePerSft: 6200,
      parkingPrice: 400000,
      utilityCharges: 200000,
      totalPrice: 10830000,
      ownership: "DEVELOPER_SHARE",
      status: "BOOKED"
    },
    {
      id: "3",
      unitCode: "Apt #7-A",
      projectName: "Sobhagya Grand Heights",
      floorLevel: "7th Floor",
      unitType: "APARTMENT",
      size: 1850,
      facing: "East",
      bedrooms: 4,
      bathrooms: 4,
      basePricePerSft: 7000,
      parkingPrice: 500000,
      utilityCharges: 250000,
      totalPrice: 15450000,
      ownership: "LANDOWNER_SHARE",
      status: "SOLD"
    },
    {
      id: "4",
      unitCode: "Shop #G-12",
      projectName: "City Vista Plaza",
      floorLevel: "Ground Floor",
      unitType: "COMMERCIAL_SHOP",
      size: 450,
      facing: "Road Facing",
      bedrooms: 0,
      bathrooms: 1,
      basePricePerSft: 12000,
      parkingPrice: 0,
      utilityCharges: 100000,
      totalPrice: 5500000,
      ownership: "DEVELOPER_SHARE",
      status: "AVAILABLE"
    },
    {
      id: "5",
      unitCode: "Apt #9-C",
      projectName: "Sobhagya Grand Heights",
      floorLevel: "9th Floor",
      unitType: "APARTMENT",
      size: 1550,
      facing: "South-East",
      bedrooms: 3,
      bathrooms: 3,
      basePricePerSft: 6800,
      parkingPrice: 400000,
      utilityCharges: 200000,
      totalPrice: 10940000,
      ownership: "DEVELOPER_SHARE",
      status: "BLOCKED"
    },
  ]);

  const handleExport = (config: any) => {
    console.log("Export config:", config);
    // TODO: Implement export logic
  };

  const handleAddUnit = (data: any) => {
    console.log("Add unit data:", data);
    // TODO: Implement save logic
  };

  const handleBulkCreate = (data: any) => {
    console.log("Bulk create data:", data);
    // TODO: Implement bulk save logic
  };

  const formatCurrency = (amount: number) => "৳ " + amount.toLocaleString("en-BD");

  // Filtering Logic
  const filteredUnits = units.filter((item) => {
    const matchesSearch = 
      item.unitCode.toLowerCase().includes(searchTerm.toLowerCase()) ||
      item.projectName.toLowerCase().includes(searchTerm.toLowerCase()) ||
      item.floorLevel.toLowerCase().includes(searchTerm.toLowerCase());

    const matchesType = selectedType === "ALL" || item.unitType === selectedType;
    const matchesStatus = selectedStatus === "ALL" || item.status === selectedStatus;

    return matchesSearch && matchesType && matchesStatus;
  });

  // KPI Calculations
  const totalUnits = units.length;
  const availableUnits = units.filter(u => u.status === "AVAILABLE").length;
  const bookedUnits = units.filter(u => u.status === "BOOKED").length;
  const soldUnits = units.filter(u => u.status === "SOLD").length;
  const blockedUnits = units.filter(u => u.status === "BLOCKED").length;

  return (
    <div className="w-full space-y-6 text-[#E2E8F0]">
      
      {/* 1. Breadcrumb & Page Header */}
      <div className="space-y-3 pb-2 border-b border-[#1E3E37]">
        <div className="flex items-center gap-2 text-xs text-[#829B96]">
          <span>Dashboard</span>
          <ChevronRight className="h-3 w-3" />
          <span>Projects & Property</span>
          <ChevronRight className="h-3 w-3" />
          <span className="text-white font-medium">Unit Management</span>
        </div>

        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h1 className="text-2xl font-bold tracking-tight text-white">Unit Management</h1>
            <p className="text-xs text-[#829B96] mt-0.5">
              Manage property units and allocations
            </p>
          </div>

          <div className="flex items-center gap-2">
            <Button 
