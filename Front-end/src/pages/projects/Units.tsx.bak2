                  <th className="p-3.5">Project</th>
                  <th className="p-3.5">Floor</th>
                  <th className="p-3.5">Type</th>
                  <th className="p-3.5">Size (Sft)</th>
                  <th className="p-3.5">Facing</th>
                  <th className="p-3.5">Beds/Baths</th>
                  <th className="p-3.5">Total Price</th>
                  <th className="p-3.5">Ownership</th>
                  <th className="p-3.5">Status</th>
                  <th className="p-3.5 text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-[#1E3E37]">
