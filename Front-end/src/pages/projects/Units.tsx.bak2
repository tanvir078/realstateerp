          <button
            onClick={() => setViewMode("MATRIX")}
            className={`p-1.5 rounded ${viewMode === "MATRIX" ? "bg-[#10B981] text-slate-950" : "text-[#829B96] hover:text-white"}`}
          >
            <Grid className="h-4 w-4" />
          </button>
        </div>
      </div>

      {/* 4. Units Table View */}
      {viewMode === "TABLE" && (
        <div className="bg-[#112421] border border-[#1E3E37] rounded-xl overflow-hidden">
