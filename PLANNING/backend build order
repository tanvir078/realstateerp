Service হবে business workflow-এর কেন্দ্র:

```typescript
async create(dto: CreateClientDto, user: User) {
  await this.validateDuplicate(dto);
  const client = await this.repository.create(dto, user);
  await this.audit.log('CLIENT_CREATED', client.id, user.id);
  await this.events.publish(new ClientCreatedEvent(client.id));
  return this.mapper.toResponse(client);
}
```

