                      <td className="p-3.5 font-mono text-[#10B981] font-medium">{unit.unitCode}</td>
                      <td className="p-3.5 text-white">{unit.projectName}</td>
                      <td className="p-3.5 text-[#829B96]">{unit.floorLevel}</td>
                      <td className="p-3.5 text-[#829B96]">{unit.unitType.replace("_", " ")}</td>
                      <td className="p-3.5 text-white">{unit.size.toLocaleString()}</td>
                      <td className="p-3.5 text-[#829B96]">{unit.facing}</td>
                      <td className="p-3.5 text-white">{unit.bedrooms}B/{unit.bathrooms}B</td>
                      <td className="p-3.5 font-semibold text-white">{formatCurrency(unit.totalPrice)}</td>
                      <td className="p-3.5 text-[#829B96]">{unit.ownership.replace("_", " ")}</td>
                      <td className="p-3.5">
