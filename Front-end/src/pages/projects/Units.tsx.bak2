            >
              {type === "ALL" ? "All" : type.replace("_", " ")}
            </button>
          ))}
        </div>

        {/* Status Filter */}
        <div className="flex items-center gap-2 overflow-x-auto w-full md:w-auto text-xs">
          <span className="text-[#829B96] flex items-center gap-1 mr-1">
