        <div className="bg-[#112421] border border-[#1E3E37] p-3 rounded-xl space-y-1">
          <p className="text-[10px] text-[#829B96] font-medium uppercase tracking-wider">Sold</p>
          <p className="text-lg font-bold text-rose-400">{soldUnits}</p>
        </div>
        <div className="bg-[#112421] border border-[#1E3E37] p-3 rounded-xl space-y-1">
          <p className="text-[10px] text-[#829B96] font-medium uppercase tracking-wider">Blocked</p>
          <p className="text-lg font-bold text-purple-400">{blockedUnits}</p>
        </div>
      </div>

      {/* 3. Search & Filter Bar */}
